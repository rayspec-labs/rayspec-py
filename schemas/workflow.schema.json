          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!~)(?!/)(?!.*\\{[{%])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00-\\x1f\\x7f]*[^/\\x00-\\x1f\\x7f]$"
          },
          "description": "Files the step promises to write, relative to its working directory (e.g. 'build/report.md'). Not templated: put what varies in the step's cwd:."
        },
        "each": {
          "title": "Each",
          "type": "string"
        },
        "as": {
          "default": "item",
          "title": "As",
          "type": "string"
        },
        "steps": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/PromptStep"
              },
              {
