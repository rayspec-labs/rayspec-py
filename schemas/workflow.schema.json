              },
              {
                "$ref": "#/$defs/StopStep"
              }
            ]
          },
          "title": "Steps",
          "type": "array"
        },
        "max_parallel": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Parallel"
        },
        "on_failure": {
          "default": "fail",
          "enum": [
