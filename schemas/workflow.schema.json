            "$ref": "#/$defs/McpServerDef"
          },
          "title": "Mcp",
          "type": "object"
        },
        "provider_options": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Provider Options",
          "type": "object"
        },
        "extends": {
          "title": "Extends",
          "type": "string"
        }
      },
      "required": [
        "extends"
      ],
      "title": "AgentOverride",
      "type": "object"
    },
    "ApproveSpec": {
      "additionalProperties": false,
      "description": "A human gate.\n\n``class:`` names the *approval class* the gate belongs to. The class itself is not defined\nhere — a workflow must not be able to decide how strictly it is gated — it is named so that\nan operator's policy can say what may approve it and so that ``--approve-class`` can\npre-authorise one kind of gate without pre-authorising every gate.\n\n``auto_if:`` is a condition that approves the gate without asking. It can only ever *add* an\nautomatic approval to what the class already permits: a class that may not be approved\nautomatically is never approved automatically, whatever the expression evaluates to.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "on_reject": {
          "default": "cancel",
          "enum": [
            "cancel",
            "continue",
            "fail"
          ],
          "title": "On Reject",
          "type": "string"
        },
        "class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class"
        },
        "auto_if": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auto If"
        }
      },
      "required": [
        "message"
      ],
      "title": "ApproveSpec",
      "type": "object"
    },
    "ApproveStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "needs": {
          "items": {
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        },
        "when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        },
        "join": {
          "default": "all",
          "enum": [
            "all",
            "any",
            "always"
          ],
          "title": "Join",
          "type": "string"
        },
        "timeout": {
          "default": null,
          "title": "Timeout",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^(?=.*\\d)\\s*(?:\\d+(?:\\.\\d+)?h)?\\s*(?:\\d+(?:\\.\\d+)?m(?!s))?\\s*(?:\\d+(?:\\.\\d+)?s)?\\s*(?:\\d+ms)?\\s*$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds (90) or a duration string ('90s', '1h30m')."
        },
        "always_run": {
          "default": false,
          "title": "Always Run",
          "type": "boolean"
        },
        "allow_failure": {
          "default": false,
          "title": "Allow Failure",
          "type": "boolean"
        },
        "artifacts": {
          "title": "Artifacts",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!~)(?!/)(?!.*\\{[{%])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00-\\x1f\\x7f]*[^/\\x00-\\x1f\\x7f]$"
          },
          "description": "Files the step promises to write, relative to its working directory (e.g. 'build/report.md'). Not templated: put what varies in the step's cwd:."
        },
        "approve": {
          "anyOf": [
            {
              "type": "string",
              "description": "Shorthand for {message: <text>}."
            },
            {
              "$ref": "#/$defs/ApproveSpec"
            }
          ]
        }
      },
      "required": [
        "id",
        "approve"
      ],
      "title": "ApproveStep",
      "type": "object"
    },
    "CommandsSpec": {
      "additionalProperties": false,
      "description": "``commands:`` — which shell commands an agent may run, as regular expressions.\n\nBoth lists are Python regular expressions matched against the command line a provider is\nabout to run; ``deny`` is checked first, and a non-empty ``allow`` means \"nothing else\".\nThey are validated (and compiled) at load time so a broken pattern is a file-and-line error\nrather than a control that quietly matches nothing.\n\nEnforcement needs the provider to hand rayspec its tool calls before they run. A provider\nthat can do that declares ``command_policy`` in its capabilities; on every other provider\n``rayspec validate`` warns that the block is advisory. See ``docs/policy.md``.",
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        }
      },
      "title": "CommandsSpec",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "timeout": {
          "default": null,
          "title": "Timeout",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(?=.*\\d)\\s*(?:\\d+(?:\\.\\d+)?h)?\\s*(?:\\d+(?:\\.\\d+)?m(?!s))?\\s*(?:\\d+(?:\\.\\d+)?s)?\\s*(?:\\d+ms)?\\s*$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds (90) or a duration string ('90s', '1h30m')."
        },
        "max_parallel": {
          "default": 4,
          "minimum": 1,
          "title": "Max Parallel",
          "type": "integer"
        },
        "on_unsupported": {
          "default": "error",
          "enum": [
            "error",
            "warn"
          ],
          "title": "On Unsupported",
          "type": "string"
        },
        "on_step_failure": {
          "default": "drain",
          "enum": [
            "drain",
            "fail_fast",
            "continue"
          ],
          "title": "On Step Failure",
          "type": "string"
        },
        "budget_usd": {
          "default": null,
          "title": "Budget Usd",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\$?\\s*\\d+(?:\\.\\d+)?\\s*(?:[Uu][Ss][Dd])?\\s*$"
            },
            {
              "type": "null"
            }
          ],
          "description": "A USD amount (1.5) or a string ('$1.50', '12 USD')."
        },
        "max_tokens": {
          "default": null,
          "title": "Max Tokens",
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(?:_\\d+)*(?:\\.\\d+)?\\s*[kKmM]?\\s*$"
            },
            {
              "type": "null"
            }
          ],
          "description": "A token count (500000) or a string ('500k', '1.5M')."
        },
        "timeout_total": {
          "default": null,
          "title": "Timeout Total",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^(?=.*\\d)\\s*(?:\\d+(?:\\.\\d+)?h)?\\s*(?:\\d+(?:\\.\\d+)?m(?!s))?\\s*(?:\\d+(?:\\.\\d+)?s)?\\s*(?:\\d+ms)?\\s*$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds (90) or a duration string ('90s', '1h30m')."
        }
      },
      "title": "Defaults",
      "type": "object"
    },
