        },
        "instructions_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions File"
        },
        "instructions_mode": {
          "default": "append",
          "enum": [
            "append",
            "replace"
          ],
          "title": "Instructions Mode",
          "type": "string"
        },
        "max_turns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turns"
        },
        "budget_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Usd"
        },
        "tools": {
          "$ref": "#/$defs/ToolsSpec"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "commands": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandsSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thinking": {
          "anyOf": [
            {
