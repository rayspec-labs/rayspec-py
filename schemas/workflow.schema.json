{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rayspec-labs/rayspec-py/main/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "A rayspec workflow document (.rayspec/workflows/<name>.yaml).",
  "$defs": {
    "AgentDef": {
      "additionalProperties": false,
      "description": "A (possibly partial) agent definition. Unset fields are filled by merge/tier resolution.",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "access": {
          "default": "workspace-write",
          "enum": [
            "read-only",
            "workspace-write",
            "full"
          ],
          "title": "Access",
          "type": "string"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "instructions_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions File"
        },
        "instructions_mode": {
          "default": "append",
          "enum": [
            "append",
            "replace"
          ],
          "title": "Instructions Mode",
          "type": "string"
        },
        "max_turns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turns"
        },
        "budget_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Usd"
        },
        "tools": {
          "$ref": "#/$defs/ToolsSpec"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "commands": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandsSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thinking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "mcp": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServerDef"
          },
          "title": "Mcp",
          "type": "object"
        },
        "provider_options": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Provider Options",
          "type": "object"
        }
      },
      "title": "AgentDef",
      "type": "object"
    },
    "AgentOverride": {
