            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds (90) or a duration string ('90s', '1h30m')."
        },
        "always_run": {
          "default": false,
          "title": "Always Run",
          "type": "boolean"
        },
        "allow_failure": {
