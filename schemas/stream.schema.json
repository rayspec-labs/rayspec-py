{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rayspec-labs/rayspec-py/main/schemas/stream.schema.json",
  "title": "StreamRecord",
  "description": "One line of a step's agent/shell transcript (steps/<path>/stream.jsonl).",
  "properties": {
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "attempt": {
      "default": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Id"
    },
    "nested": {
      "default": false,
      "title": "Nested",
      "type": "boolean"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
  },
  "required": [
    "kind"
  ],
  "type": "object"
}
